proc echo.Rainbow {argv} {
  if { [catch {exec which lolcat 2> /dev/null} ] == 0 } { exec echo "$argv" | lolcat -f >@ stdout } else { exec echo "$argv" >@ stdout }
}
proc echo.Reset {argv} {
  exec echo $argv | tr -d \[:cntrl:\] | sed -E {s/\[((;)?[0-9]{1,3}){0,3}m//g} >@ stdout; exec echo >@ stdout
}
